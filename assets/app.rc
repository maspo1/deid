// deid 리소스: 아이콘, 매니페스트, 버전 정보 (화면은 egui 로 그린다 — src/gui)
#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

IDI_APP ICON "icon/app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041204B0"
    BEGIN
      VALUE "FileDescription", "deid - 개인정보 비식별화"
      VALUE "FileVersion", "0.4.0"
      VALUE "ProductName", "deid"
      VALUE "ProductVersion", "0.4.0"
      VALUE "OriginalFilename", "deid.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0412, 1200
  END
END
